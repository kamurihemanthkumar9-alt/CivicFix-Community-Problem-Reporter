# CivicFix - Environment Configuration
# Copy this file to .env and provide your Supabase details to enable live cloud backend.
# If left blank, CivicFix runs automatically in Local Demo Mode using localStorage.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
